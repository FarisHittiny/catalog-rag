# Pick ONE generation provider. See PLAN.md > Stack.
LLM_PROVIDER=anthropic          # anthropic | openai | tamu
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TAMU Chat API is OpenAI-compatible: https://chat-api.tamu.ai/openai
TAMU_CHAT_API_KEY=

GEN_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-opus-4-1     # use a different model than GEN_MODEL for the judge
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
