# Generation + judge go through one OpenAI-compatible endpoint (llm.py).
# The TAMU Chat API is OpenAI-compatible: https://chat-api.tamu.ai/openai
LLM_BASE_URL=https://chat-api.tamu.ai/openai
LLM_API_KEY=                    # bearer key; falls back to TAMU_CHAT_API_KEY if empty
TAMU_CHAT_API_KEY=
LLM_MODEL=                      # generator, e.g. protected.gpt-5.4-mini
JUDGE_MODEL=                    # judge; use a different model than LLM_MODEL

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
